const char* ssid = "Your SSID";
const char* password = "Your password";
const char* mqtt_server = "homeassistant.local"; // eg. your-demo.cedalo.cloud or 192.168.1.11
const uint16_t mqtt_server_port = 1883; // or 8883 most common for tls transport
const char* mqttUser = "homeassistant";
const char* mqttPassword = "Yahz2nihie2couJ8zootee1ae5aingi5caing6ucaicigha2Eeshiel7eew3Eith";
const char* deviceId = "some_device"; // unique device identifier

// MQTT airtime controls. These reduce Wi-Fi traffic before messages leave the adapter.
//
// GE_BRIDGE_PUBLISH_ONLY_ON_CHANGE:
//   true:  publish an allowed ERD only when its value changes.
//          Example: Closed, Closed, Closed -> publish the first Closed only.
//          Example: Closed, Open -> publish Open immediately.
//   false: allow unchanged ERDs to repeat, limited by GE_BRIDGE_MIN_PUBLISH_INTERVAL_MSEC.
//
// GE_BRIDGE_MIN_PUBLISH_INTERVAL_MSEC:
//   Applies only to allowed ERD value topics:
//     geappliances/<deviceId>/erd/0xNNNN/value
//   It throttles repeated unchanged values when GE_BRIDGE_PUBLISH_ONLY_ON_CHANGE is false.
//   It does not delay changed values; changes publish immediately.
//   It does not control the uptime topic.
//
// GE_BRIDGE_UPTIME_PUBLISH_INTERVAL_MSEC:
//   Applies only to:
//     geappliances/<deviceId>/uptime
//
// Leave GE_BRIDGE_PUBLISH_ERD_ALLOWLIST undefined to publish every ERD.
#define GE_BRIDGE_PUBLISH_ONLY_ON_CHANGE false
#define GE_BRIDGE_MIN_PUBLISH_INTERVAL_MSEC 0UL
#define GE_BRIDGE_UPTIME_PUBLISH_INTERVAL_MSEC 1000UL
#define GE_BRIDGE_SUBSCRIBE_TO_WRITES true
#define GE_BRIDGE_PUBLISH_WRITE_RESULTS true

// Example door-focused allowlist for a GE Profile refrigerator.
// 5UL * 60UL * 1000UL is 5 minutes in milliseconds.
// #define GE_BRIDGE_PUBLISH_ERD_ALLOWLIST \
//   { \
//     0x120e, 0x125c, 0x125b, 0x120f, 0x125d, 0x1267, \
//     0x127a, 0x1279, 0x1288, 0x127c, 0x128b, 0x128f \
//   }

#endif
